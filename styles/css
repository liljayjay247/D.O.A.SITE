* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background-color: #111;
    color: white;
}

/* Sections */

section {
    padding: 70px 8%;
}

h2 {
    text-align: center;
    font-size: 36px;
    margin-bottom: 40px;
}
/* Buttons */

button {
    background-color: white;
    color: black;

    border: none;
    padding: 12px 25px;

    font-size: 16px;

    cursor: pointer;
}

/*navigation*/


header {
    background-color: #000;
    padding: 20px;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

nav a:hover {
    color: #aaa;
}
button {
    background-color: white;
    color: black;

    border: none;
    padding: 12px 25px;

    font-size: 16px;

    cursor: pointer;
}

button:hover {
    background-color: #ccc;
}
/* Hero */

.hero {
    min-height: 500px;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 40px;
}

.hero-text {
    max-width: 700px;
}

.hero h1 {
    font-size: 60px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 20px;
    line-height: 1.6;
    margin-bottom: 30px;
}


/* Music */

.music-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 30px;
}

.music-card {
    background-color: #222;
    padding: 20px;
    text-align: center;
}

.music-card img {
    width: 100%;
    height: 250px;

    object-fit: cover;

    margin-bottom: 15px;
}

.music-card h3 {
    margin-bottom: 15px;
}

audio {
    width: 100%;
    margin-bottom: 15px;
}


/* Events */

.events-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 30px;
}

.event-card {
    background-color: #222;
    padding: 30px;

    text-align: center;
}

.event-card h3 {
    margin-bottom: 20px;
}

.event-card p {
    margin-bottom: 10px;
}

.event-card button {
    margin-top: 15px;
}


/* Membership */

#membership {
    text-align: center;
}

.membership-card {
    max-width: 400px;

    margin: auto;

    background-color: #222;

    padding: 40px;
}

.membership-card h3 {
    font-size: 28px;
    margin-bottom: 20px;
}

.price {
    font-size: 30px;
    margin-bottom: 25px;
}

.membership-card ul {
    list-style: none;

    line-height: 2;

    margin-bottom: 25px;
}


/* Footer */

footer {
    background-color: #000;

    text-align: center;

    padding: 30px;
}
/* Mobile */

@media (max-width: 768px) {

    header {
        flex-direction: column;
        gap: 20px;
    }

    nav a {
        margin: 5px;
    }

    .hero h1 {
        font-size: 40px;
    }

    .music-grid {
        grid-template-columns: 1fr;
    }

    .events-grid {
        grid-template-columns: 1fr;
    }
}
    
